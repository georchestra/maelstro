{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "vue-i18n-extract": "vue-i18n-extract report --add --remove --vueFiles './src/**/*.?(ts|vue)' --languageFiles './src/locales/*.?(json|yml|yaml|js)'"
  },
  "dependencies": {
    "@primeuix/styles": "^3.0.0",
    "@primevue/forms": "^5.0.0",
    "@primevue/themes": "^4.2.5",
    "pinia": "^4.0.0",
    "primeicons": "^8.0.0",
    "primelocale": "^2.0.0",
    "primevue": "^5.0.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.0",
    "postcss": "^8.5.2",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-primeui": "^0.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^5.0.0",
    "vue-i18n-extract": "^2.0.7",
    "vue-tsc": "^3.0.0"
  }
}
